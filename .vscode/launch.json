    "version": "0.2.0",
    "configurations": [
        {
            "name": "flutter_provider_data (development)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=ENV=dev"
            ]
        },
        {
            "name": "flutter_provider_data (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=ENV=dev"
            ]
        },

        {
        "name": "flutter_provider_data (testing)",
        "request": "launch",
        "type": "dart",
        "args": [
            "--dart-define=ENV=test"
        ]
        },

        {
            "name": "flutter_provider_data (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=ENV=prod"
            ]
        }
    ]
}